# ── AI Engineering Team — Environment Variables ─────────────────────────────
# Copy this file to `.env` and fill in your API keys.
# NEVER commit `.env` to git — it is already ignored via `.gitignore`.
# NEVER share your API keys.

# Select the AI provider: "openai", "anthropic", "gemini", or "nvidia"
AI_PROVIDER=gemini

# ── Gemini (Google) ─────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# ── NVIDIA (alternative) ────────────────────────────────────────────────────
# AI_PROVIDER=nvidia
# NVIDIA_API_KEY=
# NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# ── OpenAI (alternative) ────────────────────────────────────────────────────
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# OPENAI_MAX_TOKENS=4096
# OPENAI_TEMPERATURE=0.7

# ── Anthropic (alternative) ─────────────────────────────────────────────────
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# ANTHROPIC_MAX_TOKENS=4096

# ── Logging ─────────────────────────────────────────────────────────────────
# AI_TEAM_LOG_LEVEL=INFO
# AI_TEAM_LOG_FORMAT=%(asctime)s [%(levelname)s] %(name)s: %(message)s